PORT=3040
# API key que envía cada ERP en header X-Billing-Api-Key.
# Antes de arrancar, generar una key aleatoria de al menos 32 bytes y configurar key@erpId.
# El gateway falla de forma segura al iniciar mientras esta variable siga vacía.
BILLING_API_KEYS=

# Store durable local (SQLite). Vacío = ./data/emissions.sqlite (gitignored).
# Una instancia / un host. Multi-réplica necesita store compartido (Postgres/Redis; no implementado).
BILLING_STORE_PATH=

# Default si un tenant no tiene connectionMode en registry (nunca usar live por defecto)
DEFAULT_CONNECTION_MODE=stub

# URL base documentada; stub NO la llama
# El path histórico developers.gosocket.net/sandbox está bloqueado (308→403).
# QA vigente (manual GetDocument / onboarding 2026-08): developers-sbx.
GOSOCKET_SANDBOX_URL=https://developers-sbx.gosocket.net/api/v1/
GOSOCKET_LIVE_URL=https://developers.gosocket.net/api/v1/

# Credenciales GoSocket. Un par por sociedad (erpId + empresaId del ERP).
# El ERP NO guarda ApiUser/password: solo envía empresaId + BillerId.
# Fallback global si no hay par por empresa (no usar si hay varias sociedades).
GOSOCKET_API_USER=00000000-0000-0000-0000-000000000000
GOSOCKET_API_PASSWORD=REEMPLAZAR_EN_ENV_LOCAL
GOSOCKET_API_USER_ALMAHUE_EMP_EXPORT=00000000-0000-0000-0000-000000000000
GOSOCKET_API_PASSWORD_ALMAHUE_EMP_EXPORT=REEMPLAZAR_EN_ENV_LOCAL
GOSOCKET_API_USER_ALMAHUE_EMP_SERVICES=00000000-0000-0000-0000-000000000000
GOSOCKET_API_PASSWORD_ALMAHUE_EMP_SERVICES=REEMPLAZAR_EN_ENV_LOCAL

# Mapping estándar del ejemplo GoSocket; se puede sobreescribir por tenant/QA más adelante.
GOSOCKET_MAPPING=11111111-1111-1111-1111-111111111111

