# Copiar a .env en /opt/billing_gateway. No commitear secretos.

PORT=3040
BILLING_HOST_PORT=3040
BILLING_BIND_HOST=0.0.0.0
BILLING_STORE_PATH=/app/data/emissions.sqlite
# CORS vacío: solo habla el API del ERP en la red Docker (no el navegador).
BILLING_CORS_ORIGINS=

# key@erpId — la key debe coincidir con BILLING_GATEWAY_API_KEY del ERP.
# Generar: openssl rand -base64 48
BILLING_API_KEYS=

DEFAULT_CONNECTION_MODE=sandbox

GOSOCKET_SANDBOX_URL=https://developers-sbx.gosocket.net/api/v1/
GOSOCKET_LIVE_URL=https://developers.gosocket.net/api/v1/
GOSOCKET_API_USER=
GOSOCKET_API_PASSWORD=
# Un par por sociedad. El ERP identifica la empresa; el gateway elige la ApiKey.
# GOSOCKET_API_USER_ALMAHUE_EMP_EXPORT=
# GOSOCKET_API_PASSWORD_ALMAHUE_EMP_EXPORT=
# GOSOCKET_API_USER_ALMAHUE_EMP_SERVICES=
# GOSOCKET_API_PASSWORD_ALMAHUE_EMP_SERVICES=
GOSOCKET_MAPPING=
