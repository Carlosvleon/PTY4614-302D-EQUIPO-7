{
  "name": "erp_back",
  "version": "0.0.1",
  "description": "ERP v1 Web — Backend NestJS + Prisma",
  "author": "Almahue / Devint",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "test": "jest --runInBand",
    "verify": "npm run build && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:tipo-cambio": "jest --testPathPattern=\"tipo-cambio.util.spec|indicadores-bc-import.util.spec\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "seed:tipos-referencia": "node prisma/seed-tipos-referencia.cjs",
    "seed:codigos-financieros-reu": "ts-node -r tsconfig-paths/register prisma/seed-codigos-financieros-reu.ts",
    "seed:demo-real": "ts-node -r tsconfig-paths/register prisma/seed-demo-real.ts",
    "seed:aprobaciones-f2": "ts-node -r tsconfig-paths/register prisma/seed-aprobaciones-fase2.ts",
    "seed:demo-propuesta": "ts-node -r tsconfig-paths/register prisma/run-seed-demo-propuesta.ts",
    "reset:superadmin": "ts-node -r tsconfig-paths/register scripts/reset-solo-superadmin.ts",
    "seed:qa-desde-cero": "ts-node -r tsconfig-paths/register prisma/seed-qa-desde-cero.ts",
    "seed:qa-holding": "ts-node -r tsconfig-paths/register prisma/seed-qa-holding-almahue.ts",
    "seed:organigrama-packing": "ts-node -r tsconfig-paths/register prisma/seed-organigrama-packing-demo.ts",
    "qa:contratistas-nivel1": "ts-node -r tsconfig-paths/register scripts/qa-contratistas-nivel1-integral.ts"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^16.4.7",
    "jose": "^5.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
