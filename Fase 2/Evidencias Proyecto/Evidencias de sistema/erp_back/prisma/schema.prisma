  @@schema("erp")
}

model MovimientoCartola {
  id                 String            @id @default(cuid())
  cartolaId          String
  cartola            CartolaBancaria   @relation(fields: [cartolaId], references: [id], onDelete: Cascade)
  fecha              DateTime
  referencia         String
  glosa              String
  monto              Decimal           @db.Decimal(18, 2)
  tipo               TipoMovimientoFin
  estadoContable     EstadoContableMov @default(PENDIENTE)
  asientoId          String?
  asientoNumero      String?
  /// Pago que calzó este movimiento (denormalizado; único).
  pagoId             String?           @unique
  /// Contracuenta del asiento CARTOLA (banco sale de Config SII).
  cuentaContraId     String?
  cuentaContra       CuentaContable?   @relation("MovimientoCartolaContra", fields: [cuentaContraId], references: [id], onDelete: SetNull)
  /// FACTURA | ANTICIPO | TRASPASO | SUELDO | RENDICION | OTRO
  destinoTipo        String?
  codigoFinancieroId String?
  codigoFinanciero   CodigoFinanciero? @relation(fields: [codigoFinancieroId], references: [id], onDelete: SetNull)
  tipoDocumento      String?
  folioDocumento     String?
  proveedorId        String?
  proveedor          Proveedor?        @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  clienteId          String?
  cliente            Cliente?          @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  centroCostoId      String?
  areaNegocioId      String?
  elementoCostoId    String?
  /// Semana de nómina YYYY-MM-Sn (solo egresos). No asienta.
  nominaSemana       String?
  empresaId          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([cartolaId])
  @@index([empresaId])
  @@index([codigoFinancieroId])
  @@index([empresaId, nominaSemana])
  @@schema("erp")
}

model Conciliacion {
