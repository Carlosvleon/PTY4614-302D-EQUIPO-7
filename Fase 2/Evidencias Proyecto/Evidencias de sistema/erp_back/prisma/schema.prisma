generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["erp"]
}

model Empresa {
  id                        String                      @id
  rut                       String                      @unique
  razonSocial               String
  giro                      String?
  activa                    Boolean                     @default(true)
  /// Dirección / contacto para plantillas de documento (cotización, OC).
  direccion                 String?
  comuna                    String?
  ciudad                    String?
  telefono                  String?
  emailContacto             String?
  /// Nombre del representante legal. Opcional; no reemplaza la razón social.
  representanteLegalNombre  String?
  /// RUT del representante legal. Opcional.
  representanteLegalRut     String?
  /// Mail de contacto del representante legal. No es el mail de la empresa (emailContacto).
  representanteLegalEmail   String?
  /// Teléfono de contacto del representante legal. Opcional.
  representanteLegalTelefono String?
  /// Logo (URL pública o data-URL). Sin object storage en v1.
  logoUrl                   String?                     @db.Text
  /// Sello / marca de agua imagen (URL o data-URL), opcional.
  selloUrl                  String?                     @db.Text
  /// Opciones de plantilla: logo, pie, dirección, columnas, watermark texto.
  plantillaDoc              Json?
  /// Días sin reclamo para marcar factura de compra como aceptada (plazo). No aprueba la OC.
  aceptacionCompraPlazoDias Int                         @default(8)
  /// UUID BillerID de GoSocket (portal). Obligatorio al emitir DTE vía billing-gateway.
  gosocketBillerId          String?
  /// N° resolución SII/QA que autoriza DTE (CAE). Distinto por sociedad; cambia en productivo.
  gosocketNroResolucion     String?
  /// Fecha resolución SII/QA (YYYY-MM-DD) para CAE.
  gosocketFechaResolucion   String?
  /// Código de actividad SII (Acteco, 6 dígitos). Obligatorio en DTE 33.
  gosocketActeco String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  sucursales        Sucursal[]
  usuarios          Usuario[]
  usuariosAcceso    UsuarioEmpresa[]
  centrosCosto      CentroCosto[]
  areasNegocio      AreaNegocio[]
  contratistas      Contratista[]
  tarifas           TarifaContratista[]
  labores           Labor[]
  actividades       Actividad[]
  proformas         ProformaContratista[]
  indicadoresBc     IndicadorBc[]
  syncBcMeta        SyncBcMeta[]
  ingresosLabor     IngresoLaborDiario[]
  periodosCierre    PeriodoCierreContratista[]
  ordenesCompra     OrdenCompra[]
  aprobacionesOc    AprobacionOc[]
  recepcionesOc     RecepcionOc[]
  registrosCompra   RegistroCompra[]
  insumos           Insumo[]
  bodegas           Bodega[]
  movimientosBodega MovimientoBodega[]
  stocksInsumoBodega StockInsumoBodega[]
  reservasStock     ReservaStock[]
  cuentasContables  CuentaContable[]
  elementosCosto    ElementoCosto[]
  factoresHonorario FactorHonorario[]
  asientos          Asiento[]
  periodosContables PeriodoContable[]
  configsContableSii ConfigContableSii[]
  movimientosCaja   MovimientoCaja[]
  pagos             Pago[]
  pagoTcEventos     PagoTcEvento[]
  aperturaCorrecciones AperturaCorreccion[]
  cartolas          CartolaBancaria[]
  conciliaciones    Conciliacion[]
  anticipos         AnticipoProductor[]
  documentosAging   DocumentoAging[]
  presupuestos      Presupuesto[]
  clientes          Cliente[]
  proveedores       Proveedor[]
  prospectos        Prospecto[]
  documentosCom     DocumentoComercial[]
  workflows         WorkflowConfig[]
  delegacionesAprobacion DelegacionAprobacion[]
  gruposAprobacion  GrupoAprobacion[]
  nodosEscalaAprobacion NodoEscalaAprobacion[]
  cuentasCorrientes CuentaCorrienteMovimiento[]
  guiasDespacho     GuiaDespacho[]
  adminConceptos    AdminConcepto[]
  catalogoImportaciones CatalogoImportacion[]
  codigosFinancieros CodigoFinanciero[]
  conceptosFlujo     ConceptoFlujo[]
  contratistaVigenciaHist   ContratistaVigenciaHistorial[]
  eventosCierreContratista  PeriodoCierreContratistaEvento[]
  tiposContratoContratista  TipoContratoContratista[]
  auditoriasContratista     AuditoriaContratista[]

  @@schema("erp")
}

model Sucursal {
  id        String   @id @default(cuid())
  codigo    String
  nombre    String
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

model Rol {
  id               String    @id
  codigo           String    @unique
  nombre           String
  permisos         String[]
  /// Matriz por pantalla [{ pantalla, lectura, escritura }] — persistida (Reu 3).
  permisosPantalla Json?
  /// Si true, aprobar/rechazar solicita PIN de 4 dígitos (Sergio).
  aprobarConPin    Boolean   @default(false)
  usuarios         Usuario[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@schema("erp")
}

model Usuario {
  id                      String                   @id
  email                   String                   @unique
  /// Nombre de usuario / login corto (ej. MRODRIGUEZ). Distinto del nombre completo.
  username                String?                  @unique
  passwordHash            String
  /// Clave personal de reversa/rechazo post-aprobación (D3 Reu4). Distinta del password de login.
  claveReversaHash        String?
  /// PIN de 4 dígitos para aprobar/rechazar (solo si el rol tiene aprobarConPin).
  pinAprobacionHash       String?
  /// Object ID (oid) de Microsoft Entra ID — login SSO opcional.
  microsoftOid            String?                  @unique
  microsoftLinkedAt       DateTime?
  nombre                  String
  activo                  Boolean                  @default(true)
  /// Rol temporal (opcional): fuera de rango el usuario queda inactivo para RBAC.
  rolVigenciaDesde        DateTime?
  rolVigenciaHasta        DateTime?
  /// Jefe directo (línea de mando para aprobaciones Reu6).
  jefeId                  String?
  jefe                    Usuario?                 @relation("UsuarioJefe", fields: [jefeId], references: [id], onDelete: SetNull)
  subordinados            Usuario[]                @relation("UsuarioJefe")
  /// Tope individual de aprobación (null = sin límite configurado).
  montoMaxAprobacion      Decimal?                 @db.Decimal(18, 2)
  /// Empresa primaria / por defecto (también incluida en empresasAcceso).
  empresaId               String
  rolId                   String
  empresa                 Empresa                  @relation(fields: [empresaId], references: [id])
  rol                     Rol                      @relation(fields: [rolId], references: [id])
  empresasAcceso          UsuarioEmpresa[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  tablePreferences        UiTablePreference[]
  notificaciones          Notificacion[]
  delegacionesTitular     DelegacionAprobacion[]   @relation("DelegacionTitular")
  delegacionesSuplente    DelegacionAprobacion[]   @relation("DelegacionSuplente")
  gruposAprobacion        UsuarioGrupoAprobacion[]
  gruposAprobacionEntrada GrupoAprobacion[]        @relation("GrupoAprobacionEntrada")
  nodosEscala             NodoEscalaAprobacion[]   @relation("NodoEscalaUsuario")
  nodosEscalaSiguiente    NodoEscalaAprobacion[]   @relation("NodoEscalaSiguiente")
  nodosAprobador          NodoAprobador[]          @relation("NodoAprobadorUsuario")
  adminConceptos          AdminConcepto[]          @relation("AdminConceptoUsuario")
  catalogoImportaciones   CatalogoImportacion[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@schema("erp")
}

/// N:M usuario ↔ empresas permitidas (Reu 3 / D4).
model UsuarioEmpresa {
  usuarioId String
  empresaId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([usuarioId, empresaId])
  @@index([empresaId])
  @@schema("erp")
}

enum CatalogoImportacionTipo {
  PLAN_CUENTAS
  CENTROS_COSTO
  ELEMENTOS_COSTO
  AREAS_NEGOCIO
  CODIGOS_FINANCIEROS

  @@schema("erp")
}

/// Auditoría de imports Excel de catálogos (quién, cuándo, qué se pisó).
model CatalogoImportacion {
  id            String                  @id @default(cuid())
  tipo          CatalogoImportacionTipo
  archivoNombre String?
  created       Int                     @default(0)
  updated       Int                     @default(0)
  unchanged     Int                     @default(0)
  politicas     Json?
  /// Códigos actualizados + campos pisados (acotado).
  resumen       Json?
  usuarioId     String?
  usuarioEmail  String?
  usuarioNombre String?
  usuario       Usuario?                @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  empresaId     String
  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt     DateTime                @default(now())

  @@index([empresaId, tipo, createdAt])
  @@schema("erp")
}

/// Preferencias de columnas por usuario y pantalla/lista (show/hide + orden).
model UiTablePreference {
  id             String   @id @default(cuid())
  userId         String
  usuario        Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Clave estable de lista, ej. `admin.usuarios`, `catalogos.monedas`
  tableKey       String
  visibleColumns Json
  columnOrder    Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, tableKey])
  @@index([userId])
  @@schema("erp")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@schema("erp")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  usuario   Usuario   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@schema("erp")
}

/// Centros de costo por empresa (DEC-03: sin selección cross-empresa)
model CentroCosto {
  id                String               @id
  codigo            String
  nombre            String
  activa            Boolean              @default(true)
  contactoEncargado String?
  empresaId         String
  empresa           Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vigenciaDesde     DateTime?
  vigenciaHasta     DateTime?
  tarifas           TarifaContratista[]
  ingresosLabor     IngresoLaborDiario[]
  cuentasVinculo    CuentaCentroCosto[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

/// Área de negocio (dimensión por empresa; Reu6 D9).
model AreaNegocio {
  id             String              @id @default(cuid())
  codigo         String
  nombre         String
  activa         Boolean             @default(true)
  empresaId      String
  empresa        Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cuentasVinculo CuentaAreaNegocio[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

/// Agrupador del flujo de caja (ítem del Excel de Mario). UI: Concepto.
model ConceptoFlujo {
  id                 String             @id @default(cuid())
  codigo             String
  nombre             String
  orden              Int                @default(0)
  activo             Boolean            @default(true)
  empresaId          String
  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigosFinancieros CodigoFinanciero[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, activo, orden])
  @@schema("erp")
}

/// Maestro de códigos financieros (Parametrización). Catálogo Agrosoft (R4-25) lo carga Almahue; seed local solo trae ejemplos Reu1–3.
model CodigoFinanciero {
  id         String         @id @default(cuid())
  codigo     String
  nombre     String
  activa     Boolean        @default(true)
  conceptoId String?
  concepto   ConceptoFlujo? @relation(fields: [conceptoId], references: [id], onDelete: SetNull)
  empresaId  String
  empresa    Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimientosCartola MovimientoCartola[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, activa])
  @@index([conceptoId])
  @@schema("erp")
}

model Moneda {
  id             String   @id @default(cuid())
  codigo         String   @unique
  nombre         String
  simbolo        String
  activa         Boolean  @default(true)
  focoReporteria Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@schema("erp")
}

model UnidadMedida {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("erp")
}

model TipoDocumento {
  id        String   @id @default(cuid())
  codigo    String
  nombre    String
  modulo    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([codigo, modulo])
  @@schema("erp")
}

/// Indicadores diarios Banco Central (USD/EUR/CNY). empresaId opcional (global si null).
model IndicadorBc {
  id                String   @id @default(cuid())
  fecha             DateTime
  usd               Decimal  @db.Decimal(18, 4)
  eur               Decimal  @db.Decimal(18, 4)
  cny               Decimal  @db.Decimal(18, 4)
  fuente            String   @default("BCCh")
  completadoFeriado Boolean  @default(false)
  /// manual | auto
  origenSync        String?
  empresaId         String?
  empresa           Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fecha])
  @@index([empresaId])
  @@schema("erp")
}

/// Meta de sync BC — singleton global (id=default) o por empresa.
model SyncBcMeta {
  id                String    @id @default(cuid())
  lastSync          DateTime?
  autoSync          Boolean   @default(false)
  horaProgramada    String    @default("09:00")
  /// Horas HH:mm separadas por coma (modo «horarios»).
  horarios          String    @default("09:00")
  /// Si se informa, consulta cada N minutos dentro de la ventana (modo intervalo).
  frecuenciaMinutos Int?
  ventanaInicio     String    @default("09:00")
  ventanaFin        String    @default("18:00")
  /// Solo lunes a viernes.
  diasHabiles       Boolean   @default(true)
  /// Último slot ejecutado (YYYY-MM-DDTHH:mm) para no duplicar.
  lastCronSlot      String?
  /// OK | ERROR | SKIPPED
  lastStatus        String?
  lastError         String?   @db.Text
  /// Fallos consecutivos del cron (alerta si ≥ 2).
  failStreak        Int       @default(0)
  empresaId         String?
  empresa           Empresa?  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([empresaId])
  @@schema("erp")
}

model Contratista {
  id            String                @id
  rut           String
  razonSocial   String
  especialidad  String
  activo        Boolean               @default(true)
  vigenciaHasta DateTime?
  empresaId     String
  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarifas       TarifaContratista[]
  proformas     ProformaContratista[]
  ingresosLabor IngresoLaborDiario[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  direccion          String?
  ciudad             String?
  comuna             String?
  email              String?
  telefono1          String?
  telefono2          String?
  representanteLegal String?
  rutRepresentante   String?
  tipoPago           String?
  observaciones      Json?
  proveedorId        String?
  proveedor          Proveedor?            @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  vigenciaHistorial  ContratistaVigenciaHistorial[]

  @@unique([empresaId, rut])
  @@index([proveedorId])
  @@schema("erp")
}

/// Snapshot de cambios de vigencia del contratista (Reu1).
model ContratistaVigenciaHistorial {
  id              String      @id @default(cuid())
  contratistaId   String
  contratista     Contratista @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  empresaId       String
  empresa         Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  activo          Boolean
  vigenciaHasta   DateTime?
  registradoAt    DateTime    @default(now())
  usuarioId       String
  usuarioNombre   String

  @@index([contratistaId, registradoAt])
  @@schema("erp")
}

/// Tipo operacional/contable del trabajo externo (p. ej. Mano de Obra, Transporte).
model TipoContratoContratista {
  id                     String                @id @default(cuid())
  codigo                 String
  nombre                 String
  cuentaDebeId           String
  cuentaDebe             CuentaContable        @relation("TipoContratoDebe", fields: [cuentaDebeId], references: [id], onDelete: Restrict)
  cuentaHaberId          String
  cuentaHaber            CuentaContable        @relation("TipoContratoHaber", fields: [cuentaHaberId], references: [id], onDelete: Restrict)
  cuentaAdministracionId String
  cuentaAdministracion   CuentaContable        @relation("TipoContratoAdministracion", fields: [cuentaAdministracionId], references: [id], onDelete: Restrict)
  activa                 Boolean               @default(true)
  empresaId              String
  empresa                Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tarifas                TarifaContratista[]
  ingresos               IngresoLaborDiario[]
  proformas              ProformaContratista[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@schema("erp")
}

/// Catálogo Labor (parametrización en Contratistas, DEC-01)
model Labor {
  id            String               @id
  codigo        String
  nombre        String
  activa        Boolean              @default(true)
  empresaId     String
  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  actividades   LaborActividad[]
  tarifas       TarifaContratista[]
  ingresosLabor IngresoLaborDiario[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

/// Catálogo Actividad
model Actividad {
  id            String               @id
  codigo        String
  nombre        String
  activa        Boolean              @default(true)
  empresaId     String
  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  labores       LaborActividad[]
  tarifas       TarifaContratista[]
  ingresosLabor IngresoLaborDiario[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

/// N:N Labor ↔ Actividad (generalmente 1:1; N:N permitido)
model LaborActividad {
  laborId     String
  actividadId String
  labor       Labor     @relation(fields: [laborId], references: [id], onDelete: Cascade)
  actividad   Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  @@id([laborId, actividadId])
  @@schema("erp")
}

/// Líneas de tarifa persistentes (C-03). CC debe ser de la misma empresa.
model TarifaContratista {
  id             String                   @id @default(cuid())
  contratistaId  String
  contratista    Contratista              @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  laborId        String
  laborRef       Labor                    @relation(fields: [laborId], references: [id])
  actividadId    String
  actividadRef   Actividad                @relation(fields: [actividadId], references: [id])
  tipoContratoId String?
  tipoContrato   TipoContratoContratista? @relation(fields: [tipoContratoId], references: [id])
  tarifa         Decimal                  @db.Decimal(18, 2)
  unidad         String
  centroCostoId  String
  centroCosto    CentroCosto              @relation(fields: [centroCostoId], references: [id])
  empresaId      String
  empresa        Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ingresos       IngresoLaborDiario[]
  vigenciaDesde  DateTime
  vigenciaHasta  DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([empresaId])
  @@index([contratistaId])
  @@index([tipoContratoId])
  @@schema("erp")
}

enum EstadoProforma {
  BORRADOR
  PENDIENTE_APROBACION
  DEFINITIVA
  FACTURADA
  RECHAZADA

  @@schema("erp")
}

/// Proforma contratista (C-06). Flujo Borrador → Pendiente aprobación → Definitiva → Facturada.
/// N:1 factura: la FK 1:1 queda en la proforma “principal”; las demás usan facturaNumeroRef.
model ProformaContratista {
  id                   String               @id @default(cuid())
  numero               String
  contratistaId        String
  contratista          Contratista          @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  empresaId            String
  empresa              Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodo              String
  montoNeto            Decimal              @db.Decimal(18, 2)
  moneda               String               @default("CLP")
  estado               EstadoProforma       @default(BORRADOR)
  tipoContratoId       String?
  tipoContrato         TipoContratoContratista? @relation(fields: [tipoContratoId], references: [id])
  /// Supervisor a quien se solicitó la aprobación (no se sobrescribe al resolver).
  aprobadorId          String?
  aprobadorNombre      String?
  /// Cadena calculada al solicitar (ids en orden). Reu6 escalamiento.
  aprobacionCadenaIds  String[]             @default([])
  aprobacionPasoActual Int                  @default(1)
  aprobacionPasosTotal Int                  @default(1)
  /// Quien efectivamente aprobó / rechazó (puede ser otro jefe de la regla).
  aprobadoPorId        String?
  aprobadoPorNombre    String?
  aprobadaAt           DateTime?
  /// Usuario que creó la proforma (para notificar resultado).
  creadoPorId          String?
  creadoPorNombre      String?
  /// Nº factura compartida cuando esta proforma no es la dueña del registro FacturaContratista (N:1).
  facturaNumeroRef     String?
  factura              FacturaContratista?
  ingresosLabor        IngresoLaborDiario[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  registroCompraId     String?
  registroCompra       RegistroCompra?          @relation(fields: [registroCompraId], references: [id], onDelete: SetNull)
  ordenCompraId        String?
  ordenCompra          OrdenCompra?             @relation(fields: [ordenCompraId], references: [id], onDelete: SetNull)

  @@unique([empresaId, numero])
  @@index([empresaId, periodo])
  @@index([tipoContratoId])
  @@index([registroCompraId])
  @@index([ordenCompraId])
  @@schema("erp")
}

/// Factura asociada a una o más proformas (N:1). La FK proformaId apunta a la proforma principal.
model FacturaContratista {
  id                String              @id @default(cuid())
  numero            String
  proformaId        String              @unique
