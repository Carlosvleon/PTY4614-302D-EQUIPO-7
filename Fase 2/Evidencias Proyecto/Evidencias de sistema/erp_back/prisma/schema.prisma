/// Reserva de stock ligada a una OV. Hoy no se crea en cadena de aprobación
/// (aprobaciones solo Compras). `consumirReservasOv` es no-op si no hay filas.
model ReservaStock {
  id          String             @id @default(cuid())
  empresaId   String
  empresa     Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  documentoId String
  documento   DocumentoComercial @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  insumoId    String
  insumo      Insumo             @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  bodegaId    String
  bodega      Bodega             @relation(fields: [bodegaId], references: [id], onDelete: Cascade)
  cantidad    Decimal            @db.Decimal(18, 4)
  estado      EstadoReservaStock @default(ACTIVA)
  venceAt     DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([empresaId, insumoId, bodegaId, estado])
  @@index([empresaId, documentoId])
  @@index([venceAt])
  @@schema("erp")
}

model MovimientoBodega {
  id                        String                 @id @default(cuid())
  fecha                     DateTime
  tipo                      TipoMovimientoBodega
  estado                    EstadoMovimientoBodega @default(CONFIRMADO)
  /// Denormalizado (código) para listados; cruzar stock con bodegaId.
  bodega                    String
  bodegaId                  String?
  bodegaRef                 Bodega?                @relation("MovBodegaOrigen", fields: [bodegaId], references: [id], onDelete: SetNull)
  /// Bodega destino (traslado / salida proveedor).
  bodegaDestino             String?
  bodegaDestinoId           String?
  bodegaDestinoRef          Bodega?                @relation("MovBodegaDestino", fields: [bodegaDestinoId], references: [id], onDelete: SetNull)
  articulo                  String
  cantidad                  Decimal                @db.Decimal(18, 4)
  precioUnitario            Decimal                @db.Decimal(18, 4)
  facturaRef                String?
  nota                      String                 @default("")
  insumoId                  String?
  insumo                    Insumo?                @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  /// Id del movimiento pareja (salida proveedor ↔ devolución / traslado).
  parId                     String?
  /// Asiento de centralización (si ya se centralizó).
  centralizadoAsientoId     String?
  centralizadoAsientoNumero String?
  empresaId                 String
  empresa                   Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([empresaId, fecha])
  @@index([bodegaId])
  @@index([insumoId])
  @@schema("erp")
}

/// Plan de cuentas jerárquico (UI Deepsea X-X-XX-XX; Excel Agrosoft 9 dígitos / hasta 5 niveles).
model CuentaContable {
  id                       String                @id @default(cuid())
  /// Código UI: `1-0-00-00` … `1-1-01-01` o con 5º segmento Excel `1-1-01-01-001`
  codigo                   String
  /// Código origen Agrosoft (9 dígitos), opcional
  codigoExcel              String?
  nombre                   String
  /// Categoría contable (ACTIVO/PASIVO/PATRIMONIO/INGRESO/GASTO)
  tipo                     TipoCuentaContable
  /// 1=raíz … 4=cuenta UI; 5=detalle Excel (hoja imputable típica)
  nivel                    Int                   @default(1)
  padreId                  String?
  padre                    CuentaContable?       @relation("CuentaJerarquia", fields: [padreId], references: [id], onDelete: Restrict)
  hijos                    CuentaContable[]      @relation("CuentaJerarquia")
  activa                   Boolean               @default(true)
  requiereCc               Boolean               @default(false)
  requiereArea             Boolean               @default(false)
  requiereEspecie          Boolean               @default(false)
  requiereElemento         Boolean               @default(false)
  /// true = agrupación (no se imputa en asientos); false = hoja imputable
  noImputable              Boolean               @default(false)
  empresaId                String
  empresa                  Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  configsSii               ConfigContableSii[]
  centrosCosto             CuentaCentroCosto[]
  elementosCosto           CuentaElementoCosto[]
  areasNegocio             CuentaAreaNegocio[]
  movimientosCartolaContra MovimientoCartola[]   @relation("MovimientoCartolaContra")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  tiposContratoDebe           TipoContratoContratista[] @relation("TipoContratoDebe")
  tiposContratoHaber          TipoContratoContratista[] @relation("TipoContratoHaber")
  tiposContratoAdministracion TipoContratoContratista[] @relation("TipoContratoAdministracion")

  @@unique([empresaId, codigo])
  @@index([empresaId, padreId])
  @@index([empresaId, codigoExcel])
  @@schema("erp")
}

model CuentaCentroCosto {
  id            String         @id @default(cuid())
  cuentaId      String
  cuenta        CuentaContable @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  centroCostoId String
  centroCosto   CentroCosto    @relation(fields: [centroCostoId], references: [id], onDelete: Cascade)
  empresaId     String
  createdAt     DateTime       @default(now())

  @@unique([cuentaId, centroCostoId])
  @@index([empresaId])
  @@schema("erp")
}

model CuentaElementoCosto {
  id              String         @id @default(cuid())
  cuentaId        String
  cuenta          CuentaContable @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  elementoCostoId String
  elementoCosto   ElementoCosto  @relation(fields: [elementoCostoId], references: [id], onDelete: Cascade)
  empresaId       String
  createdAt       DateTime       @default(now())

  @@unique([cuentaId, elementoCostoId])
  @@index([empresaId])
  @@schema("erp")
}

model CuentaAreaNegocio {
  id            String         @id @default(cuid())
  cuentaId      String
  cuenta        CuentaContable @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  areaNegocioId String
  areaNegocio   AreaNegocio    @relation(fields: [areaNegocioId], references: [id], onDelete: Cascade)
  empresaId     String
  createdAt     DateTime       @default(now())

  @@unique([cuentaId, areaNegocioId])
  @@index([empresaId])
  @@schema("erp")
}

/// Periodo contable por empresa (abrir/cerrar; selector UI).
model PeriodoContable {
  id         String                  @id @default(cuid())
  empresaId  String
  empresa    Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Código aaaa-mm (ej. 2026-07)
  codigo     String
  anio       Int
  mes        Int
  fechaDesde DateTime
  fechaHasta DateTime
  estado     EstadoPeriodoContable   @default(ABIERTO)
  /// Preferencia “periodo activo” de la empresa (uno por tenant).
  activo     Boolean                 @default(false)
  eventos    PeriodoContableEvento[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([empresaId, codigo])
  @@index([empresaId, estado])
  @@schema("erp")
}

/// Trazabilidad apertura / cierre / reapertura de periodo (Reu5).
model PeriodoContableEvento {
  id            String          @id @default(cuid())
  periodoId     String
  periodo       PeriodoContable @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  empresaId     String
  /// ABRIR | CERRAR | REABRIR | CREAR
  accion        String
  estadoAntes   String?
  estadoDespues String
  motivo        String?
  usuarioId     String?
  usuarioNombre String?
  createdAt     DateTime        @default(now())

  @@index([periodoId, createdAt])
  @@index([empresaId, createdAt])
  @@schema("erp")
}

/// Mapeo tipo documento SII / DTE → cuenta contable (Configuración Contable).
model ConfigContableSii {
  id               String         @id @default(cuid())
  empresaId        String
  empresa          Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  /// Código SII o clave interna (33, 34, FACTURA_COMPRA, IVA_DEBITO, …)
  tipoDocumentoSii String
  codigoSii        String?
  nombre           String
  cuentaContableId String
  cuentaContable   CuentaContable @relation(fields: [cuentaContableId], references: [id], onDelete: Restrict)
  /// Dimensiones del mapeo. Si la cuenta las exige, el asiento automático las
  /// toma de aquí: el plan real de Agrosoft pide CC en casi toda cuenta de
  /// costo o ingreso y el generador no tiene de dónde deducirlas.
  centroCostoId    String?
  areaNegocioId    String?
  elementoCostoId  String?
  /// DEBE | HABER (lado típico al centralizar)
  lado             String         @default("DEBE")
  activa           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([empresaId, tipoDocumentoSii])
  @@index([empresaId])
  @@schema("erp")
}

model ElementoCosto {
  id             String                @id @default(cuid())
  codigo         String
  nombre         String
  departamento   String
  vigencia       EstadoElementoCosto   @default(VIGENTE)
  empresaId      String
  empresa        Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cuentasVinculo CuentaElementoCosto[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([empresaId, codigo])
  @@schema("erp")
}

model FactorHonorario {
  id             String    @id @default(cuid())
  factorAnterior Decimal   @db.Decimal(18, 6)
  factorNuevo    Decimal   @db.Decimal(18, 6)
  vigenciaDesde  DateTime
  /// Opcional: si null, vigente hasta que entre otro factor más nuevo.
  vigenciaHasta  DateTime?
  usuario        String
  empresaId      String
  empresa        Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([empresaId])
  @@schema("erp")
}

model Asiento {
  id        String        @id @default(cuid())
  numero    String
  /// Periodo contable aaaa-mm (o etiqueta temporada/mes)
  periodo   String?
  fecha     DateTime
  /// MANUAL | DIARIO | AJUSTE | APERTURA | CIERRE
  tipo      String        @default("MANUAL")
  glosa     String
  debe      Decimal       @db.Decimal(18, 2)
  haber     Decimal       @db.Decimal(18, 2)
  /// BORRADOR = pendiente; CONTABILIZADO; ANULADO
  estado    EstadoAsiento @default(CONTABILIZADO)
  origen    String?
  /// [{ debe, haber, cuentaId?, glosa? }]
  lineas    Json
  empresaId String
  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId, fecha])
  @@index([empresaId, periodo])
  @@index([empresaId, origen])
  @@schema("erp")
}

model MovimientoCaja {
  id         String   @id @default(cuid())
  fecha      DateTime
  concepto   String
  ingreso    Decimal  @default(0) @db.Decimal(18, 2)
  egreso     Decimal  @default(0) @db.Decimal(18, 2)
  saldo      Decimal  @default(0) @db.Decimal(18, 2)
