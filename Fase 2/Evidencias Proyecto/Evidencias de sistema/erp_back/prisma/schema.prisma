/// Corrección de un saldo de apertura. El movimiento sigue siendo el inicial; esto guarda el valor anterior.
model AperturaCorreccion {
  id                String         @id @default(cuid())
  movimientoCajaId  String
  movimientoCaja    MovimientoCaja @relation(fields: [movimientoCajaId], references: [id], onDelete: Cascade)
