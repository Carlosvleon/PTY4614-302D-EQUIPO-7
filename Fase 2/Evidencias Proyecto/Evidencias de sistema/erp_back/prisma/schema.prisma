  id             String               @id @default(cuid())
  fecha          DateTime
  contratistaId  String
  contratista    Contratista          @relation(fields: [contratistaId], references: [id], onDelete: Cascade)
  centroCostoId  String
  centroCosto    CentroCosto          @relation(fields: [centroCostoId], references: [id])
  laborId        String
  labor          Labor                @relation(fields: [laborId], references: [id])
  actividadId    String
  actividad      Actividad            @relation(fields: [actividadId], references: [id])
  tipoJornada    TipoJornadaLabor
  cantidad       Decimal              @db.Decimal(18, 4)
  precioUnitario Decimal              @db.Decimal(18, 2)
  monto          Decimal              @db.Decimal(18, 2)
  estado         EstadoIngresoLabor   @default(PENDIENTE)
  proformaId     String?
  proforma       ProformaContratista? @relation(fields: [proformaId], references: [id], onDelete: SetNull)
  facturaNumero  String?
  empresaId      String
  empresa        Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tipoContratoId String?
  tipoContrato   TipoContratoContratista? @relation(fields: [tipoContratoId], references: [id])
  tarifaId       String?
  tarifaRef      TarifaContratista?       @relation(fields: [tarifaId], references: [id], onDelete: SetNull)
  tarifaAplicada Decimal                  @default(0) @db.Decimal(18, 2)
  unidad         String                   @default("")
  precioOverride Boolean                  @default(false)
  motivoOverride String?
  aprobadorId       String?
  aprobadorNombre   String?
  aprobadoPorId     String?
  aprobadoPorNombre String?
  aprobadaAt        DateTime?

  @@index([empresaId, fecha])
  @@index([proformaId])
  @@index([tipoContratoId])
  @@index([tarifaId])
  @@schema("erp")
}

