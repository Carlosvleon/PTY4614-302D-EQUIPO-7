  tcAnterior    Decimal? @db.Decimal(18, 4)
  tcNuevo       Decimal  @db.Decimal(18, 4)
  motivo        String?
  usuarioId     String
  usuarioNombre String?
  usuarioEmail  String?
  createdAt     DateTime @default(now())

  @@index([pagoId, createdAt])
  @@index([empresaId])
  @@schema("erp")
}

model CartolaBancaria {
  id                     String              @id @default(cuid())
  banco                  String
  bancoCodigo            String?
  fechaCarga             DateTime            @default(now())
  periodo                String
  mesContable            String?
  /// CLP | USD | CNY (yuan). Una cartola = una cuenta/moneda.
  moneda                 String              @default("CLP")
  archivoNombre          String
  formato                String              @default("EXCEL")
  movimientos            Int                 @default(0)
  montoTotal             Decimal             @default(0) @db.Decimal(18, 2)
  estado                 EstadoCartola       @default(CARGADA)
  pendientesContabilizar Int                 @default(0)
  usuarioCarga           String?
