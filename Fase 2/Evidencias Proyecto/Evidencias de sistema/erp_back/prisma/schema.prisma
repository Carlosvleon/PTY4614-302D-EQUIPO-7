model Pago {
  id                  String            @id @default(cuid())
  fecha               DateTime
  beneficiario        String
  monto               Decimal           @db.Decimal(18, 2)
  medio               String
  estado              EstadoGenericoErp @default(ACTIVO)
  tcManual            Decimal?          @db.Decimal(18, 4)
  monedaPago          String?
  monedaFactura       String?
  diferenciaTc        Decimal?          @db.Decimal(18, 2)
  documentosCalce     String?
  /// PAGO_TOTAL | ANTICIPO | ANTICIPO_PRODUCTOR
  tipo                String            @default("PAGO_TOTAL")
