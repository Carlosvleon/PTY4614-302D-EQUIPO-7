model OrdenCompra {
  id                   String             @id @default(cuid())
  numero               String
  fecha                DateTime
  /// Denormalizado para listados; preferir proveedorId.
  proveedor            String
  proveedorId          String?
  proveedorRef         Proveedor?         @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  solicitante          String
  /// Usuario sesión que grabó la OC (distinto del solicitante de negocio).
  creadoPorId          String?
  creadoPorNombre      String?
  /// Jefe / aprobador asignado (usuario del ERP). María Jesús Reu1.
  aprobadorId          String?
  aprobadorNombre      String?
  /// Cadena calculada al solicitar (ids del principal de cada paso). Reu6 / compat.
  aprobacionCadenaIds  String[]           @default([])
  /// Snapshot AND/OR: [{ logica, aprobadores: [{ id, nombre, estado }] }].
  aprobacionCadena     Json?
  aprobacionPasoActual Int                @default(1)
  aprobacionPasosTotal Int                @default(1)
  moneda               String             @default("CLP")
  neto                 Decimal            @db.Decimal(18, 2)
  afacto               AfactoOc           @default(AFECTO)
  estado               EstadoDocumentoErp @default(BORRADOR)
  departamento         String
  /// Cabecera contable (Reu 3 R3-04).
  cuentaContableId     String?
  centroCostoId        String?
  elementoCostoId      String?
  distribucionCc       Json?
  /// Ítems: [{ descripcion, cantidad, precioUnitario, total }]
  lineas               Json?
  /// Referencia informativa cotización recibida, no obligatorio.
  referenciaTipo       String?
  referenciaFolio      String?
  referenciaFecha      DateTime?
  /// Plazo de pago editable en la OC (30, 60 o 90). La factura asociada hereda el vencimiento.
  condicionPagoDias    Int?
  /// Motivo al rechazar (obligatorio en bandeja; se limpia al reenviar).
  motivoRechazo        String?
  empresaId            String
  empresa              Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  aprobaciones         AprobacionOc[]
  recepciones          RecepcionOc[]
  registros            RegistroCompra[]
  proformasContratista ProformaContratista[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([proveedorId])
  @@index([aprobadorId])
  @@index([creadoPorId])
  @@schema("erp")
}

model AprobacionOc {
  id                String             @id @default(cuid())
  ocId              String
  ordenCompra       OrdenCompra        @relation(fields: [ocId], references: [id], onDelete: Cascade)
  ocNumero          String
  proveedor         String
  monto             Decimal            @db.Decimal(18, 2)
  solicitante       String
  /// Usuario jefe que debe aprobar (copia desde OC).
  aprobadorId       String?
  aprobadorNombre   String?
  /// Paso N de M en cadena jerárquica.
  pasoOrden         Int                @default(1)
  pasoTotal         Int                @default(1)
  /// SIMPLE | AND | OR del paso (runtime multi-aprobador).
  logica            String             @default("SIMPLE")
  /// Quién resolvió (aprobar/rechazar).
  resueltoPorId     String?
  resueltoPorNombre String?
  /// Copia del motivo en la fila que rechazó.
  motivoRechazo     String?
  estado            EstadoAprobacionOc @default(PENDIENTE)
  fecha             DateTime
  empresaId         String
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([empresaId])
  @@index([aprobadorId])
  @@schema("erp")
}

model RecepcionOc {
  id          String            @id @default(cuid())
  ocId        String
  ordenCompra OrdenCompra       @relation(fields: [ocId], references: [id], onDelete: Cascade)
  ocNumero    String
  fecha       DateTime
  tcAplicado  Decimal           @db.Decimal(18, 4)
  moneda      String
  monto       Decimal           @db.Decimal(18, 2)
  estado      EstadoRecepcionOc @default(BORRADOR)
  /// Ítems alineados 1:1 con OC cuando la OC tiene líneas.
  lineas      Json?
  empresaId   String
  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([empresaId])
  @@schema("erp")
}

model RegistroCompra {
  id                        String                    @id @default(cuid())
  ocId                      String?
  ordenCompra               OrdenCompra?              @relation(fields: [ocId], references: [id], onDelete: SetNull)
  ocNumero                  String
  factura                   String
  proveedorOc               String
  proveedorFactura          String
  proveedorId               String?
  proveedorRef              Proveedor?                @relation(fields: [proveedorId], references: [id], onDelete: SetNull)
  monto                     Decimal                   @db.Decimal(18, 2)
  afactoOc                  AfactoOc?
  afactoFactura             AfactoOc?
  afactoOk                  Boolean                   @default(true)
  /// P1-10: matching de 3 vías (OC-recepción-factura). true si el monto de
  /// la factura calza (±$1) contra lo recepcionado CONFIRMADO de la OC.
  matchOk                   Boolean                   @default(true)
  /// Diferencia (monto factura - recepcionado confirmado); null si no hay OC.
  matchDiff                 Decimal?                  @db.Decimal(18, 2)
  estado                    EstadoDocumentoErp        @default(BORRADOR)
  /// Aceptación comercial de la factura recibida (bitácora ERP; no SII live ni auto-PIN de OC).
  aceptacionEstado          AceptacionCompraEstado    @default(PENDIENTE)
  aceptadaAt                DateTime?
  aceptacionOrigen          AceptacionCompraOrigen?
  /// Usuario que ejecutó la aceptación/rechazo manual o vía GoSocket.
  aceptadaPorId             String?
  aceptadaPorNombre         String?
  asientoId                 String?
  asientoNumero             String?
  /// Ítems: [{ descripcion, cantidad, precioUnitario, total }]
  lineas                    Json?
  /// --- GoSocket (Fase 2): documento recibido vía Document/GetDocument (ReceiverCode). ---
  /// Único por documento; múltiples NULL permitidos (registros manuales sin GoSocket).
  gosocketGlobalDocumentId  String?
  gosocketCountryDocumentId String?
  gosocketEstado            GoSocketAceptacionEstado?
  /// AuthorityStatus SII vía GoSocket: 00 Por enviar, 01 Enviado, 02 Aprobado, 03 Rechazado SII, 04 Anulado.
  gosocketAuthorityStatus   String?
  gosocketRechazoOrigen     GoSocketRechazoOrigen?
  gosocketRechazoMotivo     String?
  gosocketPdfDisponible     Boolean                   @default(false)
  gosocketSincronizadoAt    DateTime?
  /// Folios OC (TpoDocRef 801) extraídos del XML del DTE recibido.
  gosocketOcReferencias     Json?
  /// RUT del emisor tal como lo entrega GoSocket (para matching/despliegue).
  gosocketRutEmisor         String?
  empresaId                 String
  empresa                   Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  fechaDocumento       DateTime?
  moneda               String                  @default("CLP")
  origen               String                  @default("COMPRAS")
  proformasContratista ProformaContratista[]

  @@index([empresaId])
  @@index([proveedorId])
  @@index([gosocketGlobalDocumentId])
  @@schema("erp")
}

/// Maestro de proveedores (RUT único por empresa).
model Proveedor {
  id                 String                    @id @default(cuid())
  rut                String
  razonSocial        String
  giro               String?
  contacto           String?
  email              String?
  telefono           String?
  activo             Boolean                   @default(true)
  /// D7: productor de fruta (lookup RUT unificado).
  esProductor        Boolean                   @default(false)
  /// Condición del NETO en el maestro (cualquier entero de días). La OC sigue limitada a 30/60/90.
  condicionPagoDias  Int?
  /// Días para pagar el IVA. En la ficha se ofrece de 10 en 10, y también un entero manual. Default 10.
  condicionIvaDia    Int                       @default(10)
  /// Moneda de pago del proveedor (CLP, USD, CNY…). Distinta de la moneda de cuenta bancaria.
  monedaPago         String                    @default("CLP")
  solicitadoPor      String?
  solicitadoNota     String?
  empresaId          String
  empresa            Empresa                   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenesCompra      OrdenCompra[]
  registros          RegistroCompra[]
  cuentasBancarias   ProveedorCuentaBancaria[]
  contactosFicha     ProveedorContacto[]
  direcciones        ProveedorDireccion[]
  cambios            ProveedorCambio[]
  anticiposProductor AnticipoProductor[]
  pagos              Pago[]
  movimientosCartola MovimientoCartola[]
  contratistas       Contratista[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([empresaId, rut])
  @@index([empresaId])
  @@schema("erp")
}

