  empresa           Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  bancoAnterior     String?
  bancoNuevo        String
  monedaAnterior    String
  monedaNueva       String
  montoAnterior     Decimal        @db.Decimal(18, 2)
  montoNuevo        Decimal        @db.Decimal(18, 2)
  fechaAnterior     DateTime
  fechaNueva        DateTime
  motivo            String
  usuarioId         String
  usuarioEmail      String?
  createdAt         DateTime       @default(now())

  @@index([movimientoCajaId, createdAt])
  @@index([empresaId])
  @@schema("erp")
