model ClienteDireccion {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipo      String   @default("DESPACHO")
  linea     String
  comuna    String?
  ciudad    String?
  principal Boolean  @default(false)
  empresaId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([clienteId])
  @@schema("erp")
}

model ClienteCambio {
  id            String   @id @default(cuid())
  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuarioId     String
  usuarioNombre String
  resumen       String
  antes         Json?
  despues       Json?
  empresaId     String
  createdAt     DateTime @default(now())

  @@index([empresaId])
  @@index([clienteId])
  @@schema("erp")
}

model Prospecto {
  id        String          @id @default(cuid())
  nombre    String
  contacto  String
  origen    String
  estado    EstadoProspecto @default(NUEVO)
  fecha     DateTime
  empresaId String
  empresa   Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([empresaId])
  @@schema("erp")
}

model DocumentoComercial {
  id                      String                 @id @default(cuid())
  folio                   String
  tipo                    TipoDocumentoComercial
  cliente                 String
  clienteId               String?
  clienteRef              Cliente?               @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  proveedorId             String?
  fecha                   DateTime
  neto                    Decimal                @db.Decimal(18, 2)
  /// IVA real (P1-7): antes solo se mostraba calculado en el front y nunca
  /// se contabilizaba ni se declaraba en el libro de ventas.
  iva                     Decimal?               @db.Decimal(18, 2)
  /// Detalle de costos: [{ descripcion, cantidad, precioUnitario, descuentoPct?, total }]
  lineas                  Json?
  estado                  EstadoDocumentoErp     @default(BORRADOR)
  fromReversa             Boolean                @default(false)
  folioOrigen             String?
  /// NC / anulación vinculada a factura (u otro doc) origen.
  documentoOrigenId       String?
  documentoOrigen         DocumentoComercial?    @relation("DocNcOrigen", fields: [documentoOrigenId], references: [id], onDelete: SetNull)
  notasCredito            DocumentoComercial[]   @relation("DocNcOrigen")
  asientoOriginal         String?
  asientoReversador       String?
  asientoNuevo            String?
  folioReversador         String?
  /// Referencia SII / comercial del wizard de emisión (801 OC, 802 NP, HES…).
  referenciaTipo          String?
  referenciaFolio         String?
  observaciones           String?
  /// Datos del wizard de emisión persistidos en borrador / documento.
  formaPago               String?
  fechaVencimiento        DateTime?
  indicadorVenta          String?
  descuentoGlobalPct      Decimal?               @db.Decimal(5, 2)
  cuentaContableId        String?
  centroCostoId           String?
  receptorRut             String?
  receptorGiro            String?
  receptorDireccion       String?
  receptorComuna          String?
  receptorCiudad          String?
  /// Bloque COMEX / DTE 110–112 (manual MJ). Solo aplica si indicadorVenta=EXPORTACION.
  monedaCodigo            String?
  /// Código Aduana de moneda (TpoMoneda). Ej. "13" = USD. Si falta, se deriva de monedaCodigo.
  tpoMoneda               String?
  tipoCambio              Decimal?               @db.Decimal(18, 6)
  /// Código Aduana T7 del receptor (CodPaisRecep). Distinto de país destino.
  paisRecepCodigo         String?
  paisDestino             String?
  puertoEmbarque          String?
  puertoDesembarque       String?
  clausulaVenta           String?
  viaTransporte           String?
  modalidadVenta          String?
  indTraslado             String?
  bultoTipoCodigo         String?
  bultoCantidad           Int?
  bultoMarca              String?
  montoOtraMoneda         Decimal?               @db.Decimal(18, 2)
  montoExentoOtraMoneda   Decimal?               @db.Decimal(18, 2)
  /// Fecha del documento referenciado (NC/ND export → factura 110).
  referenciaFecha         DateTime?
  /// CodRef SII: 1 anula, 2 corrige texto, 3 corrige montos.
  referenciaCod           Int?
  /// Emisión vía billing-gateway (stub / sandbox / live). Folio ERP sigue en `folio`.
  billingEmissionId       String?
  billingPartner          String?
  billingConnectionMode   String?
  billingStatus           String?
  /// Folio oficial partner (null en stub). No sustituye `folio` local automáticamente.
  folioOficial            String?
  billingGlobalDocumentId String?
  billingDisclaimer       String?                @db.Text
  billingStub             Boolean                @default(false)
  billingEmittedAt        DateTime?
  /// Autor del borrador / documento (bandeja admin con filtro usuario — Reu5).
  creadoPorId             String?
  creadoPorNombre         String?
  empresaId               String
  empresa                 Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  reservasStock           ReservaStock[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([empresaId, folio])
  @@index([empresaId])
  @@index([documentoOrigenId])
  @@index([billingEmissionId])
  @@schema("erp")
}

/// Kardex de cuentas corrientes (clientes / proveedores / productores).
model CuentaCorrienteMovimiento {
  id                   String                 @id @default(cuid())
  empresaId            String
  empresa              Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  terceroTipo          TerceroCuentaCorriente
  terceroId            String
  terceroNombre        String
  fecha                DateTime
  documentoRef         String?
  documentoTipo        String?
  debe                 Decimal                @default(0) @db.Decimal(18, 2)
  haber                Decimal                @default(0) @db.Decimal(18, 2)
  saldo                Decimal                @default(0) @db.Decimal(18, 2)
  glosa                String?
  origen               OrigenCuentaCorriente?
  pagoId               String?
  documentoComercialId String?
  registroCompraId     String?
  movimientoCartolaId  String?
  createdAt            DateTime               @default(now())

  @@index([empresaId, terceroTipo, terceroId])
  @@index([empresaId, fecha])
  @@schema("erp")
}

/// Guías de despacho (Libro comercial › Despachos).
model GuiaDespacho {
  id                   String             @id @default(cuid())
  folio                String
  cliente              String
  fecha                DateTime
  monto                Decimal            @default(0) @db.Decimal(18, 2)
  estado               EstadoGuiaDespacho @default(BORRADOR)
  documentoComercialId String?
  glosa                String?
  empresaId            String
  empresa              Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([empresaId, folio])
  @@index([empresaId])
  @@schema("erp")
}

model WorkflowConfig {
  id           String   @id @default(cuid())
  nombre       String
  modulo       String
  montoMin     Decimal  @default(0) @db.Decimal(18, 2)
  montoMax     Decimal  @db.Decimal(18, 2)
  /// Legado Reu4 («1 firma al solicitar»). Reu6 usa cadena secuencial; no limita pasos.
  aprobadores  Int      @default(1)
  /// IDs de usuarios autorizados a aprobar (config solo Admin).
  aprobadorIds String[] @default([])
  activo       Boolean  @default(true)
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId])
  @@index([modulo])
  @@schema("erp")
}

/// Suplencia temporal: el suplente aprueba en lugar del titular (vacaciones, licencia).
model DelegacionAprobacion {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titularId     String
  titular       Usuario   @relation("DelegacionTitular", fields: [titularId], references: [id], onDelete: Cascade)
  suplenteId    String
  suplente      Usuario   @relation("DelegacionSuplente", fields: [suplenteId], references: [id], onDelete: Cascade)
  /// null = todos los módulos con aprobación
  modulo        String?
  vigenciaDesde DateTime
  vigenciaHasta DateTime?
  motivo        String?
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([empresaId, titularId])
  @@index([empresaId, vigenciaDesde, vigenciaHasta])
  @@schema("erp")
}

/// Equipo / área configurable para routing de aprobaciones (fase 2).
model GrupoAprobacion {
  id                 String                   @id @default(cuid())
  empresaId          String
  empresa            Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  modulo             String
  nombre             String
  aprobadorInicialId String
  aprobadorInicial   Usuario                  @relation("GrupoAprobacionEntrada", fields: [aprobadorInicialId], references: [id])
  activo             Boolean                  @default(true)
  miembros           UsuarioGrupoAprobacion[]
  nodosEscala        NodoEscalaAprobacion[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([empresaId, modulo])
  @@schema("erp")
}

/// M:N usuario ↔ grupo de aprobación.
model UsuarioGrupoAprobacion {
  usuarioId String
  grupoId   String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  grupo     GrupoAprobacion @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, grupoId])
  @@index([grupoId])
  @@schema("erp")
}

/// Tope + escalamiento por aprobador dentro de un grupo (la escala siempre pertenece a un grupo).
model NodoEscalaAprobacion {
  id               String                 @id @default(cuid())
  empresaId        String
  empresa          Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  grupoId          String
  grupo            GrupoAprobacion        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  modulo           String
  usuarioId        String
  usuario          Usuario                @relation("NodoEscalaUsuario", fields: [usuarioId], references: [id])
  montoMax         Decimal?               @db.Decimal(18, 2)
  escalaAUsuarioId String?
  escalaA          Usuario?               @relation("NodoEscalaSiguiente", fields: [escalaAUsuarioId], references: [id], onDelete: SetNull)
  /// Nueva lógica multi-aprobador: SIMPLE | AND | OR
  logica           String                 @default("SIMPLE")
  /// FK al siguiente NodoEscalaAprobacion (nuevo estilo; usa escalaAUsuarioId como fallback)
  escalaAId        String?
  escalaASig       NodoEscalaAprobacion?  @relation("EscalaSig", fields: [escalaAId], references: [id], onDelete: SetNull)
  escalaSigDe      NodoEscalaAprobacion[] @relation("EscalaSig")
  aprobadores      NodoAprobador[]
  activo           Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([empresaId, modulo, grupoId, usuarioId])
  @@index([grupoId])
  @@schema("erp")
}

/// Aprobadores adicionales de un nodo de escala (soporte AND / OR multi-firma).
model NodoAprobador {
  id        String               @id @default(cuid())
  nodoId    String
  nodo      NodoEscalaAprobacion @relation(fields: [nodoId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario              @relation("NodoAprobadorUsuario", fields: [usuarioId], references: [id])
  orden     Int                  @default(0)
  createdAt DateTime             @default(now())

  @@unique([nodoId, usuarioId])
  @@index([nodoId])
  @@schema("erp")
}

/// Administradores delegados por módulo (pueden gestionar config de aprobaciones sin ser SUPERADMIN).
model AdminConcepto {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarioId String
  usuario   Usuario  @relation("AdminConceptoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, usuarioId, modulo])
  @@index([empresaId, modulo])
  @@schema("erp")
}

/// Registro individual de aprobación dentro de un nodo AND/OR (para saber quién aprobó de la lista).
model PasoAprobacionDetalle {
  id           String    @id @default(cuid())
  /// ID del documento al que pertenece (OC id o ProformaContratista id).
  documentoId  String
  /// Tipo de documento: "OC" | "PROFORMA"
  tipoDoc      String
  /// Nodo de la escala al que corresponde este paso.
  nodoId       String
  /// Usuario que debe aprobar (o aprobó/rechazó).
  usuarioId    String
  /// PENDIENTE | APROBADO | RECHAZADO
  estado       String    @default("PENDIENTE")
  comentario   String?
  respondidoAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([documentoId, tipoDoc, nodoId, usuarioId])
  @@index([documentoId, tipoDoc, nodoId])
  @@schema("erp")
}

/// Inbox de notificaciones por usuario (pendientes, resoluciones, etc.).
model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  usuario   Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresaId String?
  /// OC_PENDIENTE | PROFORMA_PENDIENTE | OC_RESULTADO | PROFORMA_RESULTADO | INFO
  tipo      String
  titulo    String
  detalle   String?
  href      String
  /// Clave estable para upsert (ej. oc-pend:AP-id, prf-pend:id)
  refKey    String
  monto     Decimal? @db.Decimal(18, 2)
  leida     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, refKey])
  @@index([userId, leida, createdAt])
  @@index([empresaId])
  @@schema("erp")
}
