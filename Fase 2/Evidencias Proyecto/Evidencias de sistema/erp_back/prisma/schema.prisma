model Insumo {
  id               String   @id @default(cuid())
  codigo           String
  familia          String
  subfamilia       String
  nombre           String
  /// Detalle opcional del ítem para DTE (SII DscItem, máx. 1000). Vacío = no se envía.
  detalle          String?  @db.VarChar(1000)
  unidad           String
  /// Stock/CPP viven en bodega/movimientos; se mantienen para compatibilidad lectura.
  stock            Decimal  @default(0) @db.Decimal(18, 4)
  costoPromedio    Decimal  @default(0) @db.Decimal(18, 4)
  /// D16: piso de venta editable desde el maestro. 0 = sin cargar, cae a costoPromedio.
  precioCompra     Decimal  @default(0) @db.Decimal(18, 4)
  /// Cuenta contable de centralización (D11).
  cuentaContableId String?
  /// H6: false = servicio / no mueve bodega en OV.
  inventariable    Boolean  @default(true)
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  stocksBodega      StockInsumoBodega[]
