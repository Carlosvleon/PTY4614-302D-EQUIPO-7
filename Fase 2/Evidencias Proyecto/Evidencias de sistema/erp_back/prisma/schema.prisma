  updatedAt           DateTime          @updatedAt

  @@index([empresaId])
  @@index([proveedorId])
  @@index([clienteId])
  @@schema("erp")
}

/// Auditoría de tipo de cambio del pago (T1 anticipo productor). No es log global del ERP.
model PagoTcEvento {
