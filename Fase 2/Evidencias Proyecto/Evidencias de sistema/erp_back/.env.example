PORT=3001
# Prisma multi-schema: tablas en schema PostgreSQL `erp`
DATABASE_URL=postgresql://almahue:almahue@localhost:5433/almahue?schema=erp
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:5174
# Orígenes CORS extra (CSV), además de FRONTEND_URL y localhost
CORS_ORIGINS=
PASSWORD_RESET_DEV_RETURN_LINK=true
# Docker: true ejecuta prisma migrate deploy al arrancar el contenedor
RUN_MIGRATE=false

# Uploads
UPLOAD_ROOT=./uploads

# --- Microsoft Entra ID (SSO dual; no reemplaza login local) ---
# Guía: docs/.../presentacion-demo-2026-08/01-SSO-MICROSOFT-LOCAL.md
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID
# MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0

# Cron indicadores BC (tick cada 5 min; respeta SyncBcMeta / America/Santiago)
BC_CRON_ENABLED=false
# API oficial BDE REST (token). Doc: https://si3.bcentral.cl/estadisticas/Principal1/Web_Services/documentacion.html
# Sin BC_BDE_TOKEN (ni user/pass legado) el sync cae a mindicador.cl.
# El token bcrypt contiene `$`: en .env de Nest va literal; en docker-compose duplicar cada $ ($$2a$$10$$...).
BC_BDE_TOKEN=
# Legado SOAP/REST user+pass (solo si no hay token)
BC_BDE_USER=
BC_BDE_PASS=
BCCH_USER=
BCCH_PASSWORD=
BCCH_API_URL=https://si3.bcentral.cl/SieteRestWS/SieteRestWS.asmx
# Opcional — overrides de series BDE:
# BC_BDE_SERIES_USD=F073.TCO.PRE.Z.D
# BC_BDE_SERIES_EUR_USD=F072.EUR.USD.N.O.D
# BC_BDE_SERIES_CNY_USD=F072.CNY.USD.N.O.D

# --- Billing / DTE (skill almahue-billing-dte) ---
# false = contabiliza sin partner (histórico).
# true + BILLING_STUB_INLINE=true = stub local demo (ACCEPTED_STUB).
# true + BILLING_STUB_INLINE=false = HTTP a billing-gateway (GoSocket sandbox o stub del registry).
BILLING_GATEWAY_ENABLED=false
BILLING_STUB_INLINE=true
BILLING_GATEWAY_URL=http://127.0.0.1:3040
# Obligatoria cuando billing HTTP está habilitado (STUB_INLINE=false); sin valor falla cerrado.
BILLING_GATEWAY_API_KEY=
