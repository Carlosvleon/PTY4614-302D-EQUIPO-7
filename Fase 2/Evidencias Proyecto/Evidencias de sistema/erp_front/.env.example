VITE_APP_TITLE=Almahue ERP v1

# Prefijo público de la SPA (build-time). Default `/` para npm run dev.
# Prod por IP (sin DNS): /almahue-erp/
VITE_BASE_PATH=/

# Base de la API (build-time en Vite/Docker).
# Dev: /api/v1 + proxy Vite → erp_back
# Prod (compose root): /api/v1 + nginx del contenedor web → api:3001
# Prod (subpath IP): /almahue-erp/api/v1 + nginx host strip → api:4010
# Prod (URL pública): https://erp.ejemplo.com/api/v1
VITE_API_URL=/api/v1
VITE_DEV_API_PROXY=http://localhost:3001

# Modo demo (localStorage almahue-erp-demo-mode): datos mock para módulos no conectados.
# Auth y usuarios (alta/edición/password) siempre usan erp_back.
# En build de producción el default es modo real; en dev, demo.

# SSO Microsoft: la fuente de verdad es erp_back (MICROSOFT_AUTH_ENABLED=false hasta IDs de Almahue).
# El botón se muestra deshabilitado mientras el API responde enabled=false.
# VITE_MICROSOFT_AUTH_ENABLED=true
# VITE_MICROSOFT_TENANT_ID=
# VITE_MICROSOFT_CLIENT_ID=
